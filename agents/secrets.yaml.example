apiVersion: v1
kind: Secret
metadata:
  name: claude-worker-secrets
  namespace: claude-workers
type: Opaque
stringData:
  # Required: Claude Code credentials from your Pro/Max subscription.
  #
  # Get this by running on your laptop:
  #   cat ~/.claude/.credentials.json
  #
  # Paste the entire JSON object as the value. The entrypoint writes this to
  # ~/.claude/.credentials.json inside every pod so Claude Code can authenticate
  # without an API key.
  CLAUDE_CREDENTIALS: |
    {"claudeAiOauth":{"accessToken":"...","refreshToken":"...","expiresAt":0}}

  # Required: GitHub personal access token with repo scope.
  # Needs read/write access to repos the agent will work on.
  GITHUB_TOKEN: "ghp_..."

  # Optional: Linear API key for ticket context fetching (ccw start --ticket).
  # Create at: https://linear.app/settings/api
  LINEAR_API_KEY: "lin_api_..."
