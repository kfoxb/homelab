apiVersion: v1
kind: Secret
metadata:
  name: claude-worker-secrets
  namespace: claude-workers
type: Opaque
stringData:
  # Required: Anthropic API key for Claude Code
  ANTHROPIC_API_KEY: "sk-ant-..."

  # Required: GitHub personal access token with repo scope
  # Needs: read/write access to repos the agent will work on
  GITHUB_TOKEN: "ghp_..."

  # Optional: Linear API key for ticket context fetching (ccw start --ticket)
  # Create at: https://linear.app/settings/api
  LINEAR_API_KEY: "lin_api_..."
