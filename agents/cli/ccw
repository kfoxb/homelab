#!/usr/bin/env bash
# ccw — Claude Code Worker CLI
# Wraps kubectl operations for managing Claude Code agent pods.
set -euo pipefail

# ─── Resolve template paths ───────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
POD_TEMPLATE="${CCW_POD_TEMPLATE:-${SCRIPT_DIR}/../pod-template.yaml}"
BUILD_JOB_TEMPLATE="${CCW_BUILD_JOB_TEMPLATE:-${SCRIPT_DIR}/../build-job-template.yaml}"
REGISTRY="${CCW_REGISTRY:-registry.claude-workers.svc.cluster.local:5000}"

# ─── Helpers ──────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: ccw <subcommand> [options]

Subcommands:
  build       Build a devcontainer image for a repository
  start       Start a new Claude Code worker task
  list        List all worker pods
  status      Show status of a task
  ssh         Attach to the Claude tmux session in a task
  shell       Open a bash shell in a task pod
  logs        Tail logs from a task
  stop        Gracefully stop a running task
  dismiss     Delete a task pod
  dismiss-all Delete all task pods
  queue       Show queue status and manage concurrency
  follow-up   Send a follow-up message to a Claude session
  history     Show event history for a task (or all tasks)
  feedback    Show branch info and send feedback to a task
  dashboard   Live-updating terminal overview of all worker activity

Run 'ccw <subcommand> --help' for subcommand-specific options.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not found in PATH"
}

# ─── ccw build ────────────────────────────────────────────────────────────────
cmd_build() {
  local repo="" ref="main" no_cache=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)     repo="$2";  shift 2 ;;
      --ref)      ref="$2";   shift 2 ;;
      --no-cache) no_cache=1; shift ;;
      --help|-h)
        cat <<EOF
Usage: ccw build --repo <url> [--ref <branch/tag>] [--no-cache]

Build a devcontainer image for a repository and cache it in the local registry.
The resulting image tag can be passed to 'ccw start --image <tag>'.

Options:
  --repo <url>       Git repository URL (required)
  --ref <branch/tag> Branch or tag to build from (default: main)
  --no-cache         Force rebuild even if image already exists in cache
EOF
        return 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  [[ -n "$repo" ]] || die "--repo is required"

  require_cmd kubectl
  require_cmd envsubst
  require_cmd curl
  require_cmd sha256sum

  [[ -f "$BUILD_JOB_TEMPLATE" ]] || die "build job template not found: $BUILD_JOB_TEMPLATE"

  # ── Derive repo slug from URL
  local repo_slug
  repo_slug="$(basename "$repo" .git | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"

  # ── Fetch Dockerfile contents to compute hash ──────────────────────────────
  echo "Fetching .devcontainer/Dockerfile from ${repo} at ref ${ref} ..."
  local dockerfile_content project_hash
  dockerfile_content=""
  project_hash=""

  # Try GitHub API first for github.com URLs — faster than a full clone
  if [[ "$repo" =~ github\.com[:/]([^/]+)/([^/\.]+)(\.git)?$ ]]; then
    local gh_owner="${BASH_REMATCH[1]}"
    local gh_repo="${BASH_REMATCH[2]}"
    local auth_header=""
    [[ -n "${GITHUB_TOKEN:-}" ]] && auth_header="-H Authorization: token ${GITHUB_TOKEN}"

    local http_code
    # Request raw file content; capture HTTP status on a separate last line
    dockerfile_content="$(curl -sf \
      -H "Accept: application/vnd.github.v3.raw" \
      ${GITHUB_TOKEN:+-H "Authorization: token ${GITHUB_TOKEN}"} \
      -w "\n__HTTP_STATUS__%{http_code}" \
      "https://api.github.com/repos/${gh_owner}/${gh_repo}/contents/.devcontainer/Dockerfile?ref=${ref}" \
      2>/dev/null)" || dockerfile_content=""

    if [[ -n "$dockerfile_content" ]]; then
      http_code="${dockerfile_content##*__HTTP_STATUS__}"
      dockerfile_content="${dockerfile_content%__HTTP_STATUS__*}"

      if [[ "$http_code" == "200" && -n "$dockerfile_content" ]]; then
        project_hash="$(echo "$dockerfile_content" | sha256sum | cut -c1-12)"
      elif [[ "$http_code" == "404" ]]; then
        die "No .devcontainer/Dockerfile found in ${repo} at ref ${ref}"
      else
        # HTTP error other than 404 — fall through to clone
        dockerfile_content=""
      fi
    fi
  fi

  # Fall back to cloning if the GitHub API path didn't produce a hash
  if [[ -z "$project_hash" ]]; then
    require_cmd git
    local tmpdir
    tmpdir="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '${tmpdir}'" EXIT

    echo "Cloning ${repo} (shallow) to compute Dockerfile hash ..."
    git clone --depth=1 --branch "$ref" "$repo" "${tmpdir}/repo" >/dev/null 2>&1 \
      || die "Failed to clone ${repo} at ref ${ref}"

    [[ -f "${tmpdir}/repo/.devcontainer/Dockerfile" ]] \
      || die "No .devcontainer/Dockerfile found in ${repo} at ref ${ref}"

    project_hash="$(sha256sum "${tmpdir}/repo/.devcontainer/Dockerfile" | cut -c1-12)"
  fi

  echo "Dockerfile hash: ${project_hash}"

  local final_tag="${project_hash}"
  local final_image="${REGISTRY}/${repo_slug}:${final_tag}"

  # ── Check if image is already cached in the registry ──────────────────────
  if [[ "$no_cache" -eq 0 ]]; then
    echo "Checking registry cache ..."

    # The registry is a ClusterIP service; port-forward to reach it from outside.
    local local_port=15099
    kubectl port-forward svc/registry -n claude-workers "${local_port}:5000" \
      >/dev/null 2>&1 &
    local pf_pid=$!
    # Ensure port-forward is killed on exit regardless of path taken
    # shellcheck disable=SC2064
    trap "kill ${pf_pid} 2>/dev/null || true; ${tmpdir:+rm -rf '${tmpdir}'}" EXIT

    # Give port-forward a moment to establish
    sleep 2

    local manifest_http
    manifest_http="$(curl -s -o /dev/null -w "%{http_code}" \
      "http://localhost:${local_port}/v2/${repo_slug}/manifests/${final_tag}" \
      2>/dev/null)" || manifest_http="000"

    kill "$pf_pid" 2>/dev/null || true

    if [[ "$manifest_http" == "200" ]]; then
      echo "Using cached image: ${final_image}"
      return 0
    fi

    echo "No cached image found — starting build."
  fi

  # ── Derive job name: build-<slug>-<hash> (max 63 chars) ───────────────────
  local job_name
  job_name="build-${repo_slug}-${project_hash}"
  if [[ ${#job_name} -gt 63 ]]; then
    # "build-" (6) + "-" (1) + hash (12) = 19 chars overhead; leave rest for slug
    local max_slug_len=$(( 63 - 6 - 1 - ${#project_hash} ))
    job_name="build-${repo_slug:0:$max_slug_len}-${project_hash}"
    job_name="${job_name%-}"
  fi

  # ── Apply the Kaniko Job ───────────────────────────────────────────────────
  echo "Creating build job: ${job_name}"

  export REPO_URL="$repo"
  export REPO_SLUG="$repo_slug"
  export BUILD_REF="$ref"
  export PROJECT_HASH="$project_hash"
  export FINAL_TAG="$final_tag"

  envsubst < "$BUILD_JOB_TEMPLATE" | kubectl apply -f -
  echo ""

  # ── Wait for the build pod to appear ──────────────────────────────────────
  local pod_name=""
  local waited=0
  echo -n "Waiting for build pod"
  while [[ -z "$pod_name" && $waited -lt 120 ]]; do
    pod_name="$(kubectl get pods -n claude-workers \
      -l "job-name=${job_name}" \
      -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)" || pod_name=""
    if [[ -z "$pod_name" ]]; then
      echo -n "."
      sleep 5
      waited=$(( waited + 5 ))
    fi
  done
  echo ""
  [[ -n "$pod_name" ]] || die "Timed out waiting for build pod to appear"
  echo "Build pod: ${pod_name}"
  echo ""

  # ── Stream logs for each stage in sequence ────────────────────────────────
  # Helper: wait until a named container is no longer in the 'waiting' state.
  _wait_for_container() {
    local pod="$1" container="$2"
    local w=0
    while [[ $w -lt 600 ]]; do
      local state
      state="$(kubectl get pod -n claude-workers "$pod" \
        -o jsonpath="{.status.initContainerStatuses[?(@.name==\"${container}\")].state.waiting.reason} \
{.status.containerStatuses[?(@.name==\"${container}\")].state.waiting.reason}" \
        2>/dev/null | tr -s ' ' | sed 's/^ //')" || state=""
      # Empty state or no 'waiting' means it's running or terminated
      if [[ -z "$state" || "$state" == " " ]]; then
        return 0
      fi
      sleep 5
      w=$(( w + 5 ))
    done
    return 1
  }

  echo "=== Stage 1/3: clone ==="
  _wait_for_container "$pod_name" "clone" || die "Timed out waiting for clone container"
  kubectl logs -n claude-workers -f "$pod_name" -c clone 2>/dev/null || true
  echo ""

  echo "=== Stage 2/3: build-project (devcontainer base image) ==="
  _wait_for_container "$pod_name" "build-project" || die "Timed out waiting for build-project container"
  kubectl logs -n claude-workers -f "$pod_name" -c build-project 2>/dev/null || true
  echo ""

  echo "=== Stage 3/3: build-overlay (Claude tooling layer) ==="
  _wait_for_container "$pod_name" "build-overlay" || die "Timed out waiting for build-overlay container"
  kubectl logs -n claude-workers -f -l "job-name=${job_name}" -c build-overlay 2>/dev/null || true
  echo ""

  # ── Poll for final job status (logs may exit before job status is recorded) ──
  echo "Checking build result ..."
  local job_status=""
  local attempts=0
  while [[ $attempts -lt 30 ]]; do
    local succeeded failed
    succeeded="$(kubectl get job -n claude-workers "$job_name" \
      -o jsonpath='{.status.succeeded}' 2>/dev/null)" || succeeded=""
    failed="$(kubectl get job -n claude-workers "$job_name" \
      -o jsonpath='{.status.failed}' 2>/dev/null)" || failed=""

    if [[ "${succeeded:-0}" -ge 1 ]]; then
      job_status="succeeded"; break
    elif [[ "${failed:-0}" -ge 1 ]]; then
      job_status="failed"; break
    fi

    sleep 10
    attempts=$(( attempts + 1 ))
  done

  if [[ "$job_status" == "succeeded" ]]; then
    echo ""
    echo "Build complete."
    echo "Image: ${final_image}"
  elif [[ "$job_status" == "failed" ]]; then
    echo ""
    echo "Build failed. Full logs:"
    kubectl logs -n claude-workers -l "job-name=${job_name}" --all-containers=true 2>/dev/null || true
    die "Build job ${job_name} failed"
  else
    die "Timed out waiting for build job ${job_name} to complete"
  fi
}

# ─── ccw start: image auto-detection ─────────────────────────────────────────
# Probes the repo for .devcontainer/Dockerfile via the GitHub API.
# If found: checks the local registry cache; returns cached image tag if hit,
# otherwise triggers a build (prompting the user unless auto_build=1).
# If not found: returns the base claude-worker image.
# Prints the image to use on stdout; all status messages go to stderr.
_start_detect_image() {
  local repo="$1" ref="$2" repo_slug="$3" auto_build="$4"
  local base_image="ghcr.io/kfoxb/claude-worker:latest"

  # Only support GitHub API probing for github.com URLs; fall back to base image
  # for other hosts (no way to quickly probe without cloning).
  if [[ ! "$repo" =~ github\.com[:/]([^/]+)/([^/\.]+)(\.git)?$ ]]; then
    echo "$base_image"
    return 0
  fi

  local gh_owner="${BASH_REMATCH[1]}"
  local gh_repo="${BASH_REMATCH[2]}"

  # ── Probe for .devcontainer/Dockerfile via GitHub Contents API ──────────────
  echo "Probing ${gh_owner}/${gh_repo} for .devcontainer/Dockerfile ..." >&2

  local probe_output http_code dockerfile_content
  probe_output="$(curl -sf \
    -H "Accept: application/vnd.github.v3.raw" \
    ${GITHUB_TOKEN:+-H "Authorization: token ${GITHUB_TOKEN}"} \
    -w "\n__HTTP_STATUS__%{http_code}" \
    "https://api.github.com/repos/${gh_owner}/${gh_repo}/contents/.devcontainer/Dockerfile?ref=${ref}" \
    2>/dev/null)" || probe_output=""

  if [[ -z "$probe_output" ]]; then
    # Network error or non-2xx without -f catching it — treat as no devcontainer
    echo "Could not reach GitHub API; using base image." >&2
    echo "$base_image"
    return 0
  fi

  http_code="${probe_output##*__HTTP_STATUS__}"
  dockerfile_content="${probe_output%__HTTP_STATUS__*}"

  if [[ "$http_code" == "404" || -z "$dockerfile_content" ]]; then
    echo "No .devcontainer/Dockerfile found; using base claude-worker image." >&2
    echo "$base_image"
    return 0
  fi

  if [[ "$http_code" != "200" ]]; then
    echo "GitHub API returned HTTP ${http_code}; using base image." >&2
    echo "$base_image"
    return 0
  fi

  # ── Compute hash and candidate image tag ────────────────────────────────────
  local project_hash final_tag final_image
  project_hash="$(echo "$dockerfile_content" | sha256sum | cut -c1-12)"
  final_tag="$project_hash"
  final_image="${REGISTRY}/${repo_slug}:${final_tag}"

  echo "Devcontainer Dockerfile found (hash: ${project_hash})." >&2

  # ── Check registry cache via a short-lived port-forward ─────────────────────
  local local_port=15099
  kubectl port-forward svc/registry -n claude-workers "${local_port}:5000" \
    >/dev/null 2>&1 &
  local pf_pid=$!
  # shellcheck disable=SC2064
  trap "kill ${pf_pid} 2>/dev/null || true" RETURN

  sleep 2  # let the tunnel establish

  local manifest_http
  manifest_http="$(curl -s -o /dev/null -w "%{http_code}" \
    "http://localhost:${local_port}/v2/${repo_slug}/manifests/${final_tag}" \
    2>/dev/null)" || manifest_http="000"

  kill "$pf_pid" 2>/dev/null || true

  if [[ "$manifest_http" == "200" ]]; then
    echo "Using cached image: ${final_image}" >&2
    echo "$final_image"
    return 0
  fi

  # ── No cache hit — decide whether to build ──────────────────────────────────
  echo "No cached image found for ${final_image}." >&2

  local do_build=0
  if [[ "$auto_build" -eq 1 ]]; then
    do_build=1
  else
    # Prompt interactively (default yes)
    local answer
    read -r -p "Build devcontainer image now? [Y/n] " answer </dev/tty || answer="y"
    case "${answer,,}" in
      ""|y|yes) do_build=1 ;;
      *)        do_build=0 ;;
    esac
  fi

  if [[ "$do_build" -eq 1 ]]; then
    echo "Building image (this may take several minutes) ..." >&2
    # cmd_build is defined in this same script; call it directly.
    # Redirect its stdout to stderr so only the final image tag reaches our caller.
    cmd_build --repo "$repo" --ref "$ref" >&2 \
      || die "devcontainer build failed"
    echo "$final_image"
  else
    echo "Skipping build; falling back to base claude-worker image." >&2
    echo "$base_image"
  fi
}

# ─── ccw start ────────────────────────────────────────────────────────────────
# ─── Linear ticket fetcher ────────────────────────────────────────────────────
# fetch_linear_ticket <ticket-id>
# Outputs a Markdown block with ticket context (≤2000 chars) to stdout.
# Returns non-zero and prints an error to stderr on failure.
fetch_linear_ticket() {
  local ticket_id="$1"
  local max_context=2000

  [[ -n "${LINEAR_API_KEY:-}" ]] \
    || die "--ticket requires the LINEAR_API_KEY environment variable to be set"

  require_cmd curl

  local query
  query=$(cat <<'GRAPHQL'
query GetIssue($id: String!) {
  issue(id: $id) {
    title
    description
    state { name }
    assignee { name }
    comments(last: 5, orderBy: { field: createdAt, direction: Ascending }) {
      nodes { body createdAt user { name } }
    }
  }
}
GRAPHQL
)

  local payload
  payload="$(jq -n --arg query "$query" --arg id "$ticket_id" \
    '{"query": $query, "variables": {"id": $id}}')"

  local response
  response="$(curl -s -X POST https://api.linear.app/graphql \
    -H "Authorization: ${LINEAR_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$payload")" || die "failed to reach Linear API"

  # Check for GraphQL-level errors or missing issue
  local gql_error
  gql_error="$(echo "$response" | jq -r '.errors[0].message // empty' 2>/dev/null)"
  [[ -z "$gql_error" ]] || die "Linear API error for ticket ${ticket_id}: ${gql_error}"

  local title
  title="$(echo "$response" | jq -r '.data.issue.title // empty')"
  [[ -n "$title" ]] || die "ticket not found: ${ticket_id}"

  local state assignee description
  state="$(echo "$response"       | jq -r '.data.issue.state.name // "Unknown"')"
  assignee="$(echo "$response"    | jq -r '.data.issue.assignee.name // "Unassigned"')"
  description="$(echo "$response" | jq -r '.data.issue.description // ""')"

  # Collect recent comments
  local comments_md=""
  local comment_count
  comment_count="$(echo "$response" | jq '.data.issue.comments.nodes | length')"
  if (( comment_count > 0 )); then
    comments_md="$(echo "$response" | jq -r '
      .data.issue.comments.nodes[] |
      "- [\(.user.name // "?") at \(.createdAt[:10])]: \(.body)"
    ')"
  fi

  # Build context block and truncate to max_context chars
  local header
  header="$(printf 'LINEAR TICKET: %s\nTitle: %s\nStatus: %s\nAssignee: %s\n' \
    "$ticket_id" "$title" "$state" "$assignee")"

  local body=""
  if [[ -n "$description" ]]; then
    body=$'\nDescription:\n'"$description"
  fi
  if [[ -n "$comments_md" ]]; then
    body+=$'\n\nRecent comments:\n'"$comments_md"
  fi

  local full_context="${header}${body}"

  # Truncate if needed, leaving room for header + a note
  if (( ${#full_context} > max_context )); then
    full_context="${full_context:0:$(( max_context - 20 ))}... (truncated)"
  fi

  printf '%s' "$full_context"
}

cmd_start() {
  local repo="" branch="" prompt="" ticket="" image="" auto_build=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)        repo="$2";   shift 2 ;;
      --branch)      branch="$2"; shift 2 ;;
      --prompt)      prompt="$2"; shift 2 ;;
      --ticket)      ticket="$2"; shift 2 ;;
      --image)       image="$2";  shift 2 ;;
      --auto-build)  auto_build=1; shift ;;
      --help|-h)
        cat <<EOF
Usage: ccw start --repo <url> --branch <name> --prompt <text> [options]

Options:
  --repo         <url>    Git repository URL (required)
  --branch       <name>   Branch to work on, created if absent (required)
  --prompt       <text>   Initial prompt for Claude (required)
  --ticket       <id>     Linear ticket ID (optional)
  --image        <image>  Override container image; skips auto-detection (optional)
  --auto-build            Build devcontainer image without prompting if not cached
EOF
        return 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  [[ -n "$repo"   ]] || die "--repo is required"
  [[ -n "$branch" ]] || die "--branch is required"
  [[ -n "$prompt" ]] || die "--prompt is required"

  require_cmd kubectl
  require_cmd envsubst

  [[ -f "$POD_TEMPLATE" ]] || die "pod template not found: $POD_TEMPLATE"

  # ── Derive repo slug from URL (last path component, lowercase, alnum+hyphens)
  local raw_slug
  raw_slug="$(basename "$repo" .git | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"

  # ── Auto-detect devcontainer image (skipped if --image was given explicitly)
  if [[ -z "$image" ]]; then
    image="$(_start_detect_image "$repo" "$branch" "$raw_slug" "$auto_build")"
  fi

  # ── Generate task name: <slug>-<yyyymmdd>-<4-char-random>
  # Fixed suffix length: -YYYYMMDD-XXXX = 14 chars; leave room for slug.
  local date_suffix rand_suffix
  date_suffix="$(date +%Y%m%d)"
  rand_suffix="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c4)"

  local max_slug_len=$(( 63 - 1 - ${#date_suffix} - 1 - ${#rand_suffix} ))
  local slug="${raw_slug:0:$max_slug_len}"
  # Strip trailing hyphens that may result from truncation
  slug="${slug%-}"

  local task_name="${slug}-${date_suffix}-${rand_suffix}"

  # ── Sanitize branch name for use as a Kubernetes label value
  # Label values: max 63 chars, [a-zA-Z0-9._-], must start/end with alphanum
  local branch_label
  branch_label="$(echo "$branch" | tr '/' '-' | tr -cs 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//' | cut -c1-63)"

  # ── Fetch Linear ticket context (if --ticket provided)
  if [[ -n "$ticket" ]]; then
    local ticket_context
    ticket_context="$(fetch_linear_ticket "$ticket")"
    # Prepend ticket context block to the user's prompt
    prompt="$(printf '%s\n\n---\n\nYOUR TASK:\n%s' "$ticket_context" "$prompt")"
  fi

  # ── Write prompt to temp file (avoids shell quoting issues with special chars)
  local prompt_file
  prompt_file="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$prompt_file'" EXIT
  printf '%s' "$prompt" > "$prompt_file"

  # ── Export variables consumed by envsubst + pod template
  export TASK_NAME="$task_name"
  export REPO_URL="$repo"
  export REPO_SLUG="$raw_slug"
  export GIT_BRANCH="$branch"
  export GIT_BRANCH_LABEL="$branch_label"
  export LINEAR_TICKET="${ticket:-none}"
  export CLAUDE_IMAGE="$image"

  # ── Create ConfigMap for the prompt (avoids YAML-injection of arbitrary text)
  kubectl create configmap "${task_name}-prompt" \
    -n claude-workers \
    --from-file=prompt.txt="${prompt_file}" \
    --dry-run=client -o yaml | kubectl apply -f -

  # ── Apply pod manifest
  envsubst < "$POD_TEMPLATE" | kubectl apply -f -

  echo ""
  echo "Task started: ${task_name}"
  echo "To connect:   ccw ssh ${task_name}"
  echo "To monitor:   ccw logs ${task_name} --follow"
}

# ─── Shared helpers ───────────────────────────────────────────────────────────

# format_age <ISO-8601-timestamp> → "14m" / "3h" / "2d"
format_age() {
  local ts="$1"
  local epoch_ts epoch_now diff_s

  epoch_ts="$(date -d "$ts" +%s 2>/dev/null)" \
    || epoch_ts="$(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$ts" +%s 2>/dev/null)" \
    || { echo "?"; return; }
  epoch_now="$(date +%s)"
  diff_s=$(( epoch_now - epoch_ts ))

  if (( diff_s < 3600 )); then
    echo "$(( diff_s / 60 ))m"
  elif (( diff_s < 86400 )); then
    echo "$(( diff_s / 3600 ))h"
  else
    echo "$(( diff_s / 86400 ))d"
  fi
}

# ─── ccw status ───────────────────────────────────────────────────────────────
cmd_status() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw status <task>"
    echo ""
    echo "Show detailed status and recent output for a task."
    return 0
  fi

  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw status <task>"

  require_cmd kubectl
  require_cmd jq

  # Fetch pod JSON; kubectl exits non-zero if the pod doesn't exist
  local pod_json
  pod_json="$(kubectl get pod -n claude-workers "$task" -o json 2>/dev/null)" \
    || die "task not found: ${task}"

  # ── Extract fields from labels / spec / status
  local status repo branch ticket node pod_ip created_at age
  status="$(echo "$pod_json"    | jq -r '.metadata.labels.status // "unknown"')"
  repo="$(echo "$pod_json"      | jq -r '.metadata.labels["repo-url"] // .metadata.labels.repo // "-"')"
  branch="$(echo "$pod_json"    | jq -r '.metadata.labels.branch // "-"')"
  ticket="$(echo "$pod_json"    | jq -r '.metadata.labels.ticket // "-"')"
  node="$(echo "$pod_json"      | jq -r '.spec.nodeName // "-"')"
  pod_ip="$(echo "$pod_json"    | jq -r '.status.podIP // "-"')"
  created_at="$(echo "$pod_json" | jq -r '.metadata.creationTimestamp')"
  age="$(format_age "$created_at")"

  # ── Print metadata block
  printf "Task:     %s\n"   "$task"
  printf "Status:   %s\n"   "$status"
  printf "Repo:     %s\n"   "$repo"
  printf "Branch:   %s\n"   "$branch"
  printf "Ticket:   %s\n"   "$ticket"
  printf "Node:     %s\n"   "$node"
  printf "Age:      %s\n"   "$age"
  printf "Pod IP:   %s\n"   "$pod_ip"

  # ── Fetch recent output (skip gracefully if log doesn't exist yet)
  echo ""
  echo "--- Recent output (last 30 lines) ---"
  kubectl exec -n claude-workers "$task" -- \
    tail -n 30 /workspace/.claude-output.log 2>/dev/null \
    || echo "(no output log yet)"
}

# ─── ccw list ─────────────────────────────────────────────────────────────────
cmd_list() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw list"
    echo ""
    echo "List all Claude Code worker pods."
    return 0
  fi

  require_cmd kubectl
  require_cmd jq

  # ── Color setup (only when stdout is a TTY)
  local c_reset="" c_green="" c_red="" c_yellow="" c_blue="" c_dim=""
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    c_reset="$(tput sgr0)"
    c_green="$(tput setaf 2)"
    c_red="$(tput setaf 1)"
    c_yellow="$(tput setaf 3)"
    c_blue="$(tput setaf 4)"
    c_dim="$(tput dim 2>/dev/null || true)"
  fi

  # ── Fetch pods as JSON
  local pods_json
  pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)" || {
    die "failed to query pods (is kubectl configured?)"
  }

  local pod_count
  pod_count="$(echo "$pods_json" | jq '.items | length')"

  # ── Header
  printf "%-30s %-13s %-20s %-25s %-12s %-6s %s\n" \
    "TASK" "STATUS" "REPO" "BRANCH" "TICKET" "AGE" "NODE"

  if [[ "$pod_count" -eq 0 ]]; then
    echo ""
    echo "No worker pods found."
    return 0
  fi

  # ── Color a status value
  color_status() {
    local status="$1"
    local colored
    case "$status" in
      running)      colored="${c_green}${status}${c_reset}" ;;
      done)         colored="${c_dim}${status}${c_reset}" ;;
      error)        colored="${c_red}${status}${c_reset}" ;;
      rate-limited) colored="${c_yellow}${status}${c_reset}" ;;
      queued)       colored="${c_blue}${status}${c_reset}" ;;
      *)            colored="${status}" ;;
    esac
    echo "$colored"
  }

  # ── Iterate over pods
  echo "$pods_json" | jq -c '.items[]' | while IFS= read -r pod; do
    local name status repo branch ticket age node

    name="$(echo "$pod" | jq -r '.metadata.name')"
    status="$(echo "$pod" | jq -r '.metadata.labels.status // "unknown"')"
    repo="$(echo "$pod" | jq -r '.metadata.labels.repo // "-"')"
    branch="$(echo "$pod" | jq -r '.metadata.labels.branch // "-"')"
    ticket="$(echo "$pod" | jq -r '.metadata.labels.ticket // ""')"
    node="$(echo "$pod" | jq -r '.spec.nodeName // "-"')"

    local created_at
    created_at="$(echo "$pod" | jq -r '.metadata.creationTimestamp')"
    age="$(format_age "$created_at")"

    # Truncate long fields to keep columns readable
    local repo_display branch_display ticket_display
    repo_display="${repo:0:20}"
    branch_display="${branch:0:25}"
    ticket_display="${ticket:0:12}"

    local colored_status
    colored_status="$(color_status "$status")"

    # STATUS is color-coded; account for invisible escape codes in printf width
    local status_plain_len=${#status}
    local status_colored_len=${#colored_status}
    local pad=$(( 13 + status_colored_len - status_plain_len ))

    printf "%-30s %-${pad}s %-20s %-25s %-12s %-6s %s\n" \
      "$name" "$colored_status" "$repo_display" "$branch_display" "$ticket_display" "$age" "$node"
  done
}

# ─── ccw ssh ──────────────────────────────────────────────────────────────────
cmd_ssh() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw ssh <task>"
    echo ""
    echo "Attach to the Claude tmux session in the task pod."
    echo "Detach with Ctrl+B D."
    return 0
  fi

  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw ssh <task>"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  echo "Attaching to Claude's tmux session. Detach with Ctrl+B D."

  # Check if the tmux session exists before attaching
  if ! kubectl exec -n claude-workers "$task" -- tmux has-session -t claude 2>/dev/null; then
    echo ""
    echo "Claude's tmux session no longer exists (Claude may have finished)."
    printf "Open a bash shell instead? [y/N] "
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      echo "Opening bash shell."
      kubectl exec -it -n claude-workers "$task" -- bash
    fi
    return 0
  fi

  kubectl exec -it -n claude-workers "$task" -- tmux attach -t claude
}

# ─── ccw shell ────────────────────────────────────────────────────────────────
cmd_shell() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw shell <task>"
    echo ""
    echo "Open a bash shell in the task pod."
    return 0
  fi

  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw shell <task>"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  echo "Opening bash shell. Claude is running in tmux session 'claude'."
  kubectl exec -it -n claude-workers "$task" -- bash
}

# ─── ccw logs ─────────────────────────────────────────────────────────────────
cmd_logs() {
  local task="" follow=0 lines=100

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow=1; shift ;;
      --since)
        lines="${2:-}"
        [[ "$lines" =~ ^[0-9]+$ ]] || die "--since requires a numeric argument"
        shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: ccw logs <task> [--follow] [--since <N>]

Options:
  --follow, -f   Stream new output as it arrives (tail -f)
  --since <N>    Show last N lines (default: 100)
EOF
        return 0 ;;
      -*)  die "unknown option: $1" ;;
      *)
        [[ -z "$task" ]] || die "unexpected argument: $1"
        task="$1"; shift ;;
    esac
  done

  [[ -n "$task" ]] || die "usage: ccw logs <task> [--follow] [--since <N>]"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  local log_path="/workspace/.claude-output.log"

  if [[ "$follow" -eq 1 ]]; then
    kubectl exec -n claude-workers "$task" -- \
      tail -f "$log_path" 2>/dev/null \
      || die "log file not found (pod may still be starting)"
  else
    kubectl exec -n claude-workers "$task" -- \
      tail -n "$lines" "$log_path" 2>/dev/null \
      || die "log file not found (pod may still be starting)"
  fi
}

# ─── ccw stop ─────────────────────────────────────────────────────────────────
cmd_stop() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw stop <task>"
    echo ""
    echo "Send SIGTERM to Claude inside the pod and mark the task as stopped."
    echo "The pod remains alive. Use 'ccw dismiss <task>' to remove it."
    return 0
  fi

  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw stop <task>"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  # Send SIGTERM to the claude process
  kubectl exec -n claude-workers "$task" -- pkill -SIGTERM -f 'claude' 2>/dev/null || true

  # Update status label to stopped
  kubectl label pod -n claude-workers "$task" status=stopped --overwrite >/dev/null

  echo "Claude stopped. Pod is still running. Use \`ccw dismiss ${task}\` to remove it."
}

# ─── ccw dismiss ──────────────────────────────────────────────────────────────
cmd_dismiss() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw dismiss <task>"
    echo ""
    echo "Delete a task pod. Prompts for confirmation if the task is running."
    return 0
  fi

  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw dismiss <task>"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  local status
  status="$(kubectl get pod -n claude-workers "$task" \
    -o jsonpath='{.metadata.labels.status}' 2>/dev/null)"

  if [[ "$status" == "running" ]]; then
    printf "Task is still running. Dismiss anyway? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; return 0; }
  fi

  kubectl delete pod -n claude-workers "$task"
}

# ─── ccw dismiss-all ──────────────────────────────────────────────────────────
cmd_dismiss_all() {
  local include_running=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --include-running) include_running=1; shift ;;
      --help|-h)
        cat <<EOF
Usage: ccw dismiss-all [--include-running]

Delete all task pods with status done or error.

Options:
  --include-running  Also delete running pods (prompts for confirmation)
EOF
        return 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  require_cmd kubectl
  require_cmd jq

  local pods_json
  pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)"

  # Collect done/error pods
  local done_pods=()
  while IFS= read -r name; do
    done_pods+=("$name")
  done < <(echo "$pods_json" | jq -r '.items[] | select(.metadata.labels.status == "done" or .metadata.labels.status == "error") | .metadata.name')

  # Collect running pods (only relevant if --include-running)
  local running_pods=()
  if [[ "$include_running" -eq 1 ]]; then
    while IFS= read -r name; do
      running_pods+=("$name")
    done < <(echo "$pods_json" | jq -r '.items[] | select(.metadata.labels.status == "running") | .metadata.name')
  fi

  if [[ ${#done_pods[@]} -eq 0 && ${#running_pods[@]} -eq 0 ]]; then
    echo "No pods to dismiss."
    return 0
  fi

  if [[ ${#done_pods[@]} -gt 0 ]]; then
    echo "Dismissing ${#done_pods[@]} done/error pod(s):"
    for name in "${done_pods[@]}"; do
      echo "  $name"
    done
    kubectl delete pod -n claude-workers "${done_pods[@]}"
  fi

  if [[ "$include_running" -eq 1 && ${#running_pods[@]} -gt 0 ]]; then
    echo ""
    printf "Also dismiss %d running pod(s)? [y/N] " "${#running_pods[@]}"
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for name in "${running_pods[@]}"; do
        echo "  $name"
      done
      kubectl delete pod -n claude-workers "${running_pods[@]}"
    else
      echo "Skipped running pods."
    fi
  fi
}

# ─── ccw stop-all ─────────────────────────────────────────────────────────────
cmd_stop_all() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: ccw stop-all"
    echo ""
    echo "Send SIGTERM to Claude in all running pods and mark them as stopped."
    return 0
  fi

  require_cmd kubectl
  require_cmd jq

  local pods_json
  pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)"

  local running_pods=()
  while IFS= read -r name; do
    running_pods+=("$name")
  done < <(echo "$pods_json" | jq -r '.items[] | select(.metadata.labels.status == "running") | .metadata.name')

  if [[ ${#running_pods[@]} -eq 0 ]]; then
    echo "No running pods found."
    return 0
  fi

  echo "Stopping ${#running_pods[@]} running pod(s):"
  for name in "${running_pods[@]}"; do
    echo -n "  $name ... "
    kubectl exec -n claude-workers "$name" -- pkill -SIGTERM -f 'claude' 2>/dev/null || true
    kubectl label pod -n claude-workers "$name" status=stopped --overwrite >/dev/null
    echo "stopped"
  done
}

# ─── ccw queue ────────────────────────────────────────────────────────────────

# format_duration <seconds> → "2h 15m" / "45m" / "30s"
format_duration() {
  local secs="$1"
  if (( secs <= 0 )); then
    echo "now"
  elif (( secs < 60 )); then
    echo "${secs}s"
  elif (( secs < 3600 )); then
    echo "$(( secs / 60 ))m"
  else
    local h=$(( secs / 3600 ))
    local m=$(( (secs % 3600) / 60 ))
    if (( m > 0 )); then
      echo "${h}h ${m}m"
    else
      echo "${h}h"
    fi
  fi
}

cmd_queue() {
  local subcmd="${1:-}"

  case "$subcmd" in
    --help|-h)
      cat <<EOF
Usage: ccw queue [set-limit <n> | promote <task>]

  ccw queue               Show running/queued/rate-limited counts
  ccw queue set-limit <n> Update maxConcurrent in the worker-config ConfigMap
  ccw queue promote <task> Immediately release a queued task (bypass ordering)
EOF
      return 0 ;;
    set-limit)
      shift
      cmd_queue_set_limit "$@" ;;
    promote)
      shift
      cmd_queue_promote "$@" ;;
    "")
      cmd_queue_status ;;
    *)
      die "unknown queue subcommand '${subcmd}'. Run 'ccw queue --help' for usage." ;;
  esac
}

cmd_queue_status() {
  require_cmd kubectl
  require_cmd jq

  # ── Fetch ConfigMap for limit
  local max_concurrent
  max_concurrent="$(kubectl get configmap worker-config -n claude-workers \
    -o jsonpath='{.data.maxConcurrent}' 2>/dev/null)" || max_concurrent="?"

  # ── Fetch all worker pods
  local pods_json
  pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)" \
    || die "failed to query pods (is kubectl configured?)"

  local now
  now="$(date +%s)"

  # ── Count pods by status
  local running_count queued_count rate_limited_count
  running_count="$(echo "$pods_json" | jq '[.items[] | select(.metadata.labels.status == "running")] | length')"
  queued_count="$(echo "$pods_json" | jq '[.items[] | select(.metadata.labels.status == "queued")] | length')"
  rate_limited_count="$(echo "$pods_json" | jq '[.items[] | select(.metadata.labels.status == "rate-limited")] | length')"

  # ── Find earliest retry time among rate-limited pods
  local earliest_retry="" retry_in=""
  while IFS= read -r retry_ts; do
    [[ -z "$retry_ts" || "$retry_ts" == "null" ]] && continue
    if [[ -z "$earliest_retry" || "$retry_ts" -lt "$earliest_retry" ]]; then
      earliest_retry="$retry_ts"
    fi
  done < <(echo "$pods_json" | jq -r '.items[] | select(.metadata.labels.status == "rate-limited") | .metadata.annotations["ccw/retry-after"] // empty')

  if [[ -n "$earliest_retry" ]]; then
    local secs_until=$(( earliest_retry - now ))
    retry_in="$(format_duration "$secs_until")"
  fi

  # ── Print summary
  echo "Queue Status"

  # Running line: show "at limit" if at or above limit
  if [[ "$max_concurrent" =~ ^[0-9]+$ && "$running_count" -ge "$max_concurrent" ]]; then
    printf "  Running:      %s/%s (at limit)\n" "$running_count" "$max_concurrent"
  else
    printf "  Running:      %s/%s\n" "$running_count" "$max_concurrent"
  fi

  printf "  Queued:       %s\n" "$queued_count"

  if [[ "$rate_limited_count" -gt 0 && -n "$retry_in" ]]; then
    printf "  Rate-limited: %s (retry in %s)\n" "$rate_limited_count" "$retry_in"
  else
    printf "  Rate-limited: %s\n" "$rate_limited_count"
  fi

  # ── List queued tasks (oldest first)
  if [[ "$queued_count" -eq 0 ]]; then
    return 0
  fi

  echo ""
  echo "Queued tasks (oldest first):"

  # Sort queued pods by creationTimestamp ascending
  echo "$pods_json" | jq -r '
    [.items[] | select(.metadata.labels.status == "queued")]
    | sort_by(.metadata.creationTimestamp)
    | .[]
    | [.metadata.name, (.metadata.labels.branch // "-"), .metadata.creationTimestamp]
    | @tsv
  ' | while IFS=$'\t' read -r name branch created_at; do
    local age
    age="$(format_age "$created_at")"
    printf "  %-30s %-20s queued %s\n" "$name" "$branch" "$age"
  done
}

cmd_queue_set_limit() {
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: ccw queue set-limit <n>"
  [[ "$n" -ge 1 ]] || die "limit must be at least 1"

  require_cmd kubectl

  kubectl patch configmap worker-config -n claude-workers \
    --patch "{\"data\":{\"maxConcurrent\":\"${n}\"}}"

  echo "maxConcurrent updated to ${n}"
}

cmd_queue_promote() {
  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: ccw queue promote <task>"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  local status
  status="$(kubectl get pod -n claude-workers "$task" \
    -o jsonpath='{.metadata.labels.status}' 2>/dev/null)"

  [[ "$status" == "queued" ]] || die "task '${task}' is not queued (status: ${status})"

  kubectl label pod -n claude-workers "$task" status=running --overwrite >/dev/null

  echo "Promoted ${task} to running"
}

# ─── ccw follow-up ────────────────────────────────────────────────────────────
cmd_follow_up() {
  local task="" prompt=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prompt)  prompt="$2"; shift 2 ;;
      --help|-h)
        cat <<EOF
Usage: ccw follow-up <task> [--prompt] <text>

Send a follow-up message to a Claude session.

Behavior by pod status:
  waiting-input   Sends text directly to Claude's interactive tmux prompt
  running         Queues text; delivered after Claude finishes current response
  done / stopped  Resumes Claude with --resume and the follow-up as the new prompt
  error / rate-limited / queued
                  Prints an explanatory error

Options:
  --prompt <text>  Follow-up message (can also be given as a positional argument)
EOF
        return 0 ;;
      -*) die "unknown option: $1" ;;
      *)
        if [[ -z "$task" ]]; then
          task="$1"; shift
        elif [[ -z "$prompt" ]]; then
          prompt="$1"; shift
        else
          die "unexpected argument: $1"
        fi ;;
    esac
  done

  [[ -n "$task" ]]   || die "usage: ccw follow-up <task> [--prompt] <text>"
  [[ -n "$prompt" ]] || die "a follow-up message is required"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  local status
  status="$(kubectl get pod -n claude-workers "$task" \
    -o jsonpath='{.metadata.labels.status}' 2>/dev/null)"

  case "$status" in
    waiting-input)
      # Send directly to the tmux interactive prompt.
      # Pipe the prompt via stdin to avoid shell-quoting issues with special chars.
      printf '%s' "$prompt" | kubectl exec -i -n claude-workers "$task" -- \
        bash -c 'msg=$(cat); tmux send-keys -t claude "$msg" Enter'
      echo "Follow-up sent to waiting Claude."
      ;;

    running)
      # Queue for after Claude finishes its current response.
      # The entrypoint picks up /tmp/follow-up-queue at the end of each Claude run.
      printf '%s\n' "$prompt" | kubectl exec -i -n claude-workers "$task" -- \
        bash -c "cat >> /tmp/follow-up-queue"
      echo "Follow-up queued (Claude is running; will be delivered after current response)."
      ;;

    done|stopped)
      # Restart Claude with --resume using the follow-up as the new prompt.
      # Write the prompt to the launch control file, then start a fresh tmux session.
      if ! kubectl exec -n claude-workers "$task" -- \
          test -f /tmp/claude-session-id 2>/dev/null; then
        die "no session ID found in pod — cannot resume a '${status}' pod without one"
      fi

      printf '%s' "$prompt" | kubectl exec -i -n claude-workers "$task" -- \
        bash -c "cat > /tmp/claude-current-prompt.txt"

      # Kill any lingering tmux session, then launch a new one
      kubectl exec -n claude-workers "$task" -- \
        bash -c "tmux kill-session -t claude 2>/dev/null || true; \
                 tmux new-session -d -s claude /tmp/claude-launch.sh"

      # Label the pod as running so observers know work is happening
      kubectl label pod -n claude-workers "$task" status=running --overwrite >/dev/null

      local session_id
      session_id="$(kubectl exec -n claude-workers "$task" -- \
        cat /tmp/claude-session-id 2>/dev/null)"
      echo "Claude resumed (session ${session_id}) with follow-up."
      ;;

    error|rate-limited|queued)
      die "cannot send follow-up: task is '${status}'. Follow-up requires status running, waiting-input, done, or stopped."
      ;;

    *)
      die "cannot send follow-up: unknown status '${status}'"
      ;;
  esac

  # Append a FOLLOW_UP event to the pod's event log
  local preview="${prompt:0:80}"
  printf '%s FOLLOW_UP prompt="%s"\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$preview" | \
    kubectl exec -i -n claude-workers "$task" -- \
      bash -c "cat >> /workspace/.claude-events.log" 2>/dev/null || true
}

# ─── ccw history ──────────────────────────────────────────────────────────────
cmd_history() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<EOF
Usage: ccw history [<task>]

  ccw history <task>   Show all events for the specified task
  ccw history          Show last 50 events across all running/recent pods

Event colors: STARTED=blue  DONE=green  ERROR=red  RATE_LIMITED=yellow
EOF
    return 0
  fi

  require_cmd kubectl

  # Color setup (only when stdout is a TTY)
  local c_reset="" c_green="" c_red="" c_yellow="" c_blue=""
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    c_reset="$(tput sgr0)"
    c_green="$(tput setaf 2)"
    c_red="$(tput setaf 1)"
    c_yellow="$(tput setaf 3)"
    c_blue="$(tput setaf 4)"
  fi

  local task="${1:-}"

  if [[ -n "$task" ]]; then
    # ── Single-task history ──────────────────────────────────────────────────
    kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
      || die "task not found: ${task}"

    local log_content
    log_content="$(kubectl exec -n claude-workers "$task" -- \
      cat /workspace/.claude-events.log 2>/dev/null)" \
      || die "event log not found (pod may still be starting)"

    if [[ -z "$log_content" ]]; then
      echo "(no events yet)"
      return 0
    fi

    # BRANCH_CHECKED_OUT is 18 chars — widest expected event type
    local EVENT_TYPE_WIDTH=18

    while IFS= read -r line; do
      [[ -z "$line" ]] && continue

      # Parse: TIMESTAMP EVENT_TYPE [rest...]
      local ts="${line%% *}"
      local remainder="${line#* }"
      local event_type="${remainder%% *}"
      local rest="${remainder#* }"
      # When event_type has no trailing fields, rest == event_type
      [[ "$rest" == "$event_type" ]] && rest=""

      # Format: "2024-03-15T10:00:00Z" → "2024-03-15 10:00:00"
      local display_ts="${ts%Z}"
      display_ts="${display_ts/T/ }"

      local colored_et
      case "$event_type" in
        STARTED)      colored_et="${c_blue}${event_type}${c_reset}" ;;
        *DONE*)       colored_et="${c_green}${event_type}${c_reset}" ;;
        *ERROR*)      colored_et="${c_red}${event_type}${c_reset}" ;;
        RATE_LIMITED) colored_et="${c_yellow}${event_type}${c_reset}" ;;
        *)            colored_et="${event_type}" ;;
      esac

      # Compensate printf field width for invisible color escape codes
      local plain_len=${#event_type}
      local colored_len=${#colored_et}
      local pad=$(( EVENT_TYPE_WIDTH + colored_len - plain_len ))

      printf "%-21s  %-${pad}s  %s\n" "$display_ts" "$colored_et" "$rest"
    done <<< "$log_content"

  else
    # ── Aggregate history: last 50 events across all pods ────────────────────
    require_cmd jq

    local pods_json
    pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)" \
      || die "failed to query pods (is kubectl configured?)"

    local pod_count
    pod_count="$(echo "$pods_json" | jq '.items | length')"

    if [[ "$pod_count" -eq 0 ]]; then
      echo "No worker pods found."
      return 0
    fi

    # Collect events as tab-separated: TIMESTAMP\tPOD_NAME\tEVENT_TYPE\tREST
    # ISO 8601 timestamps are lexicographically sortable, so plain sort works.
    local all_events=""
    while IFS= read -r pod_name; do
      local events
      events="$(kubectl exec -n claude-workers "$pod_name" -- \
        cat /workspace/.claude-events.log 2>/dev/null)" || continue
      [[ -z "$events" ]] && continue
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local ts="${line%% *}"
        local remainder="${line#* }"
        local event_type="${remainder%% *}"
        local rest="${remainder#* }"
        [[ "$rest" == "$event_type" ]] && rest=""
        all_events+="${ts}"$'\t'"${pod_name}"$'\t'"${event_type}"$'\t'"${rest}"$'\n'
      done <<< "$events"
    done < <(echo "$pods_json" | jq -r '.items[].metadata.name')

    if [[ -z "$all_events" ]]; then
      echo "No events found across any pods."
      return 0
    fi

    # Sort by timestamp, take last 50, then format and color each line
    while IFS=$'\t' read -r ts pod_name event_type rest; do
      [[ -z "$ts" ]] && continue

      # Show only the time portion: "2024-03-15T10:00:00Z" → "10:00:00"
      local time_part="${ts%Z}"
      time_part="${time_part#*T}"

      local colored_et
      case "$event_type" in
        STARTED)      colored_et="${c_blue}${event_type}${c_reset}" ;;
        *DONE*)       colored_et="${c_green}${event_type}${c_reset}" ;;
        *ERROR*)      colored_et="${c_red}${event_type}${c_reset}" ;;
        RATE_LIMITED) colored_et="${c_yellow}${event_type}${c_reset}" ;;
        *)            colored_et="${event_type}" ;;
      esac

      local pod_label="[${pod_name}]"
      printf "%-37s  %-10s  %s" "$pod_label" "$time_part" "$colored_et"
      [[ -n "$rest" ]] && printf "  %s" "$rest"
      printf '\n'
    done < <(echo "$all_events" | sort -t$'\t' -k1,1 | tail -n 50)
  fi
}

# ─── ccw feedback ─────────────────────────────────────────────────────────────
cmd_feedback() {
  local task="" message=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        cat <<EOF
Usage: ccw feedback <task> [<message>]

Show branch info for a task and send feedback to the Claude session.

If <message> is omitted, \$EDITOR is opened for multi-line feedback.

Examples:
  ccw feedback my-app-20240315-a3f9 "fix the tests"
  ccw feedback my-app-20240315-a3f9
EOF
        return 0 ;;
      -*) die "unknown option: $1" ;;
      *)
        if [[ -z "$task" ]]; then
          task="$1"; shift
        elif [[ -z "$message" ]]; then
          message="$1"; shift
        else
          die "unexpected argument: $1"
        fi ;;
    esac
  done

  [[ -n "$task" ]] || die "usage: ccw feedback <task> [<message>]"

  require_cmd kubectl

  kubectl get pod -n claude-workers "$task" >/dev/null 2>&1 \
    || die "task not found: ${task}"

  # ── Fetch task metadata from pod labels
  local pod_json
  pod_json="$(kubectl get pod -n claude-workers "$task" -o json 2>/dev/null)"

  local branch status
  branch="$(echo "$pod_json" | jq -r '.metadata.labels.branch // "-"')"
  status="$(echo "$pod_json" | jq -r '.metadata.labels.status // "unknown"')"

  # ── Fetch latest commit info from git inside the pod
  # Workspace path is /workspace/<repo-slug>; fall back to searching under /workspace
  local repo_slug commit_info commit_count
  repo_slug="$(echo "$pod_json" | jq -r '.metadata.labels.repo // ""')"

  local workspace_path="/workspace/${repo_slug}"
  commit_info="$(kubectl exec -n claude-workers "$task" -- \
    bash -c "git -C '${workspace_path}' log --oneline -1 2>/dev/null \
             || git -C /workspace log --oneline -1 2>/dev/null \
             || echo '(no commits yet)'")" 2>/dev/null || commit_info="(unavailable)"

  commit_count="$(kubectl exec -n claude-workers "$task" -- \
    bash -c "git -C '${workspace_path}' rev-list --count HEAD 2>/dev/null \
             || git -C /workspace rev-list --count HEAD 2>/dev/null \
             || echo '?'")" 2>/dev/null || commit_count="?"

  # ── Print metadata block
  printf "\nTask:     %s\n" "$task"
  printf "Branch:   %s\n" "$branch"
  printf "Latest:   %s (%s commits)\n" "$commit_info" "$commit_count"
  printf "Status:   %s\n\n" "$status"

  # ── If no message provided, open $EDITOR for multi-line feedback
  if [[ -z "$message" ]]; then
    local tmpfile
    tmpfile="$(mktemp --suffix=.txt)"
    # shellcheck disable=SC2064
    trap "rm -f '${tmpfile}'" EXIT

    cat > "$tmpfile" <<'TEMPLATE'

# Enter your feedback above. Lines starting with '#' are ignored.
# Save and close to send. Exit without saving to abort.
TEMPLATE

    local editor="${EDITOR:-vi}"
    "$editor" "$tmpfile"

    # Read file, strip comment lines and leading/trailing blank lines
    message="$(grep -v '^#' "$tmpfile" | sed '/./,$!d' | sed -e :a -e '/^\s*$/{$d;N;ba}')"

    if [[ -z "$message" ]]; then
      echo "No message entered. Aborted."
      return 0
    fi
  fi

  # ── Delegate to follow-up
  echo "Sending feedback..."
  cmd_follow_up "$task" "$message"

  echo ""
  echo "Claude is working on your feedback. Connect with: ccw ssh ${task}"
}

# ─── ccw dashboard ────────────────────────────────────────────────────────────
cmd_dashboard() {
  local once=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --once)   once=true; shift ;;
      --help|-h)
        echo "Usage: ccw dashboard [--once]"
        echo ""
        echo "Live-updating terminal overview of all worker activity."
        echo ""
        echo "Options:"
        echo "  --once    Print once and exit (useful for scripting)"
        return 0
        ;;
      *) die "unknown option: $1" ;;
    esac
  done

  require_cmd kubectl
  require_cmd jq

  # ── Color/formatting setup (only when stdout is a TTY)
  local is_tty=false
  local c_reset="" c_green="" c_yellow="" c_blue="" c_red="" c_dim="" c_bold=""
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    is_tty=true
    c_reset="$(tput sgr0)"
    c_green="$(tput setaf 2)"
    c_yellow="$(tput setaf 3)"
    c_blue="$(tput setaf 4)"
    c_red="$(tput setaf 1)"
    c_dim="$(tput dim 2>/dev/null || true)"
    c_bold="$(tput bold 2>/dev/null || true)"
  fi

  # Restore terminal on Ctrl+C
  cleanup_dashboard() {
    if $is_tty; then
      tput cnorm 2>/dev/null || true  # show cursor
    fi
    exit 0
  }
  trap cleanup_dashboard INT TERM

  # Hide cursor during live display (TTY only)
  if $is_tty && ! $once; then
    tput civis 2>/dev/null || true
  fi

  _render_dashboard() {
    local now
    now="$(date +%s)"

    # ── Fetch all worker pods
    local pods_json
    pods_json="$(kubectl get pods -n claude-workers -l app=claude-worker -o json 2>/dev/null)" || {
      echo "error: failed to query pods (is kubectl configured?)"
      return 1
    }

    # ── Fetch concurrency limit
    local max_concurrent
    max_concurrent="$(kubectl get configmap worker-config -n claude-workers \
      -o jsonpath='{.data.maxConcurrent}' 2>/dev/null)" || max_concurrent="?"

    # ── Count by status
    local running_count queued_count rate_limited_count waiting_count done_count error_count
    running_count="$(echo "$pods_json"      | jq '[.items[] | select(.metadata.labels.status == "running")] | length')"
    queued_count="$(echo "$pods_json"       | jq '[.items[] | select(.metadata.labels.status == "queued")] | length')"
    rate_limited_count="$(echo "$pods_json" | jq '[.items[] | select(.metadata.labels.status == "rate-limited")] | length')"
    waiting_count="$(echo "$pods_json"      | jq '[.items[] | select(.metadata.labels.status == "waiting-input")] | length')"
    done_count="$(echo "$pods_json"         | jq '[.items[] | select(.metadata.labels.status == "done")] | length')"
    error_count="$(echo "$pods_json"        | jq '[.items[] | select(.metadata.labels.status == "error")] | length')"

    # ── Header
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    printf "%s  CCW Dashboard%s  %s\n" "${c_bold}" "${c_reset}" "$timestamp"
    printf "Queue: %s%s/%s running%s  %s%s queued%s  %s%s rate-limited%s\n" \
      "${c_green}" "$running_count" "$max_concurrent" "${c_reset}" \
      "${c_blue}" "$queued_count" "${c_reset}" \
      "${c_yellow}" "$rate_limited_count" "${c_reset}"
    echo ""

    # ─ Helper: print a row for one pod
    _pod_row() {
      local pod="$1"
      local name repo branch node created_at elapsed status_label color

      name="$(echo "$pod"        | jq -r '.metadata.name')"
      repo="$(echo "$pod"        | jq -r '.metadata.labels.repo // "-"')"
      branch="$(echo "$pod"      | jq -r '.metadata.labels.branch // "-"')"
      node="$(echo "$pod"        | jq -r '.spec.nodeName // "-"')"
      created_at="$(echo "$pod"  | jq -r '.metadata.creationTimestamp')"
      elapsed="$(format_age "$created_at")"

      # Shorten node name (strip common suffix)
      node="${node##*/}"

      printf "  %-35s %-22s %-10s %s\n" \
        "${name:0:35}" "${branch:0:22}" "${node:0:10}" "$elapsed"
    }

    # ── RUNNING section
    local running_pods
    running_pods="$(echo "$pods_json" | jq -c '[.items[] | select(.metadata.labels.status == "running")] | sort_by(.metadata.creationTimestamp) | .[]')"
    if [[ -n "$running_pods" ]]; then
      printf "%sRUNNING%s\n" "${c_green}${c_bold}" "${c_reset}"
      while IFS= read -r pod; do
        _pod_row "$pod"
      done <<< "$running_pods"
      echo ""
    fi

    # ── WAITING-INPUT section
    local waiting_pods
    waiting_pods="$(echo "$pods_json" | jq -c '[.items[] | select(.metadata.labels.status == "waiting-input")] | sort_by(.metadata.creationTimestamp) | .[]')"
    if [[ -n "$waiting_pods" ]]; then
      printf "%sWAITING-INPUT%s\n" "${c_yellow}${c_bold}" "${c_reset}"
      while IFS= read -r pod; do
        _pod_row "$pod"
      done <<< "$waiting_pods"
      echo ""
    fi

    # ── QUEUED section
    local queued_pods
    queued_pods="$(echo "$pods_json" | jq -c '[.items[] | select(.metadata.labels.status == "queued")] | sort_by(.metadata.creationTimestamp) | .[]')"
    if [[ -n "$queued_pods" ]]; then
      printf "%sQUEUED%s\n" "${c_blue}${c_bold}" "${c_reset}"
      while IFS= read -r pod; do
        _pod_row "$pod"
      done <<< "$queued_pods"
      echo ""
    fi

    # ── RATE-LIMITED section (with retry countdown)
    local rate_limited_pods
    rate_limited_pods="$(echo "$pods_json" | jq -c '[.items[] | select(.metadata.labels.status == "rate-limited")] | sort_by(.metadata.creationTimestamp) | .[]')"
    if [[ -n "$rate_limited_pods" ]]; then
      printf "%sRATE-LIMITED%s\n" "${c_yellow}${c_bold}" "${c_reset}"
      while IFS= read -r pod; do
        local name branch node created_at elapsed retry_after retry_in
        name="$(echo "$pod"        | jq -r '.metadata.name')"
        branch="$(echo "$pod"      | jq -r '.metadata.labels.branch // "-"')"
        node="$(echo "$pod"        | jq -r '.spec.nodeName // "-"')"
        node="${node##*/}"
        created_at="$(echo "$pod"  | jq -r '.metadata.creationTimestamp')"
        elapsed="$(format_age "$created_at")"
        retry_after="$(echo "$pod" | jq -r '.metadata.annotations["ccw/retry-after"] // empty')"

        if [[ -n "$retry_after" && "$retry_after" != "null" ]]; then
          local secs_until=$(( retry_after - now ))
          if (( secs_until > 0 )); then
            retry_in="retry in $(format_duration "$secs_until")"
          else
            retry_in="retry imminent"
          fi
        else
          retry_in=""
        fi

        printf "  %-35s %-22s %-10s %-6s %s\n" \
          "${name:0:35}" "${branch:0:22}" "${node:0:10}" "$elapsed" "$retry_in"
      done <<< "$rate_limited_pods"
      echo ""
    fi

    # ── RECENT section: last 5 done/error pods sorted by creationTimestamp desc
    local recent_pods
    recent_pods="$(echo "$pods_json" | jq -c '
      [.items[] | select(.metadata.labels.status == "done" or .metadata.labels.status == "error")]
      | sort_by(.metadata.creationTimestamp)
      | reverse
      | .[0:5]
      | .[]
    ')"
    if [[ -n "$recent_pods" ]]; then
      printf "%sRECENT%s\n" "${c_dim}${c_bold}" "${c_reset}"
      while IFS= read -r pod; do
        local name branch node created_at elapsed status
        name="$(echo "$pod"       | jq -r '.metadata.name')"
        branch="$(echo "$pod"     | jq -r '.metadata.labels.branch // "-"')"
        node="$(echo "$pod"       | jq -r '.spec.nodeName // "-"')"
        node="${node##*/}"
        status="$(echo "$pod"     | jq -r '.metadata.labels.status // "unknown"')"
        created_at="$(echo "$pod" | jq -r '.metadata.creationTimestamp')"
        elapsed="$(format_age "$created_at")"

        local status_colored
        if [[ "$status" == "error" ]]; then
          status_colored="${c_red}${status}${c_reset}"
        else
          status_colored="${c_dim}${status}${c_reset}"
        fi

        # Pad for color codes
        local pad=$(( 8 + ${#status_colored} - ${#status} ))
        printf "  %-35s %-22s %-10s %-${pad}s %s ago\n" \
          "${name:0:35}" "${branch:0:22}" "${node:0:10}" "$status_colored" "$elapsed"
      done <<< "$recent_pods"
      echo ""
    fi

    # ── Footer (only when looping)
    if ! $once; then
      printf "%sPress Ctrl+C to exit. 'ccw ssh <task>' to connect.%s\n" "${c_dim}" "${c_reset}"
    fi
  }

  if $once; then
    _render_dashboard
    return 0
  fi

  # ── Live loop: clear and redraw every 5 seconds
  while true; do
    if $is_tty; then
      clear
    fi
    _render_dashboard
    sleep 5
  done
}

# ─── Dispatch ─────────────────────────────────────────────────────────────────
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

subcommand="$1"
shift

case "$subcommand" in
  build)       cmd_build "$@" ;;
  start)       cmd_start "$@" ;;
  --help|-h)   usage ;;
  list)        cmd_list "$@" ;;
  status)      cmd_status "$@" ;;
  ssh)         cmd_ssh "$@" ;;
  shell)       cmd_shell "$@" ;;
  logs)        cmd_logs "$@" ;;
  stop)        cmd_stop "$@" ;;
  stop-all)    cmd_stop_all "$@" ;;
  dismiss)     cmd_dismiss "$@" ;;
  dismiss-all) cmd_dismiss_all "$@" ;;
  queue)       cmd_queue "$@" ;;
  follow-up)   cmd_follow_up "$@" ;;
  history)     cmd_history "$@" ;;
  feedback)    cmd_feedback "$@" ;;
  dashboard)   cmd_dashboard "$@" ;;
  *)
    die "unknown subcommand '${subcommand}'. Run 'ccw --help' for usage." ;;
esac
